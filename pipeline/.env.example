# =============================================
# 비올라(Viola) 파이프라인 환경 변수 예시
# 복사 후 .env 로 저장하고 실제 값을 채워주세요.
# 이 파일(.env.example)은 깃허브에 올려도 됩니다.
# .env 파일은 절대 깃허브에 업로드하지 마세요.
# =============================================

# ── 기상청 API (data.go.kr) ─────────────────
KMA_API_KEY=your_kma_api_key_here

# ── 데이터베이스 (PostgreSQL + PostGIS) ──────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viola_db
DB_USER=viola_user
DB_PASSWORD=your_db_password_here

# ── 공공데이터포털 (행안부 침수흔적도 등) ────
DATA_GO_KR_KEY=your_data_go_kr_key_here
