# =============================================
# 비올라(Viola) 웹 대시보드 환경 변수 예시
# 복사 후 .env 로 저장하세요. (.env는 깃허브 업로드 금지)
# =============================================

# ── 카카오맵 JavaScript API ──────────────────
# https://developers.kakao.com 에서 앱 등록 후 발급
VITE_KAKAO_MAP_KEY=your_kakao_map_key_here

# ── 기본 시군구 코드 (대시보드 초기 로딩 지역) ─
# 서울 관악구: 11620 / 서울 영등포구: 11560
VITE_DEFAULT_SIGUNGU=11620
